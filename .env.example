# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentevalos
POSTGRES_USER=agentevalos
POSTGRES_PASSWORD=agentevalos
DATABASE_URL=postgresql+psycopg://agentevalos:agentevalos@localhost:5432/agentevalos

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=AGENTEVALOS_APP_ROLE
SNOWFLAKE_WAREHOUSE=AGENTEVALOS_WH
SNOWFLAKE_DATABASE=AGENTEVALOS
SNOWFLAKE_SCHEMA=EVALS

# --- OpenTelemetry / Phoenix ---
OTEL_SERVICE_NAME=agent-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- LLM API key (for DeepEval's judge) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- MCP ---
MCP_CONFIG_PATH=./services/agent-orchestrator/mcp_servers.yaml

# --- Services ---
AGENT_ORCHESTRATOR_PORT=8001
EVAL_ENGINE_PORT=8002
AGENT_ORCHESTRATOR_URL=http://localhost:8001
EVAL_ENGINE_URL=http://localhost:8002

# --- Console ---
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8001
NEXT_PUBLIC_EVAL_ENGINE_URL=http://localhost:8002
