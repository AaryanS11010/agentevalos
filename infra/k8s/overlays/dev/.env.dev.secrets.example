# Copy to .env.dev.secrets (gitignored) and fill in before `kustomize build overlays/dev`
# or `kubectl apply -k overlays/dev`. Consumed by the agentevalos-secrets Secret via
# kustomization.yaml's secretGenerator, and injected into agent-orchestrator/eval-engine
# via envFrom (see ../../base/agent-orchestrator.yaml, ../../base/eval-engine.yaml).
# For a real cluster, prefer a secrets manager (e.g. external-secrets) over this file.
DATABASE_URL=postgresql+psycopg://agentevalos:agentevalos@postgres:5432/agentevalos
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=AGENTEVALOS_APP_ROLE
SNOWFLAKE_WAREHOUSE=AGENTEVALOS_WH
SNOWFLAKE_DATABASE=AGENTEVALOS
SNOWFLAKE_SCHEMA=EVALS
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
