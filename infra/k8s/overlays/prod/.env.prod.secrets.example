# Copy to .env.prod.secrets (gitignored) and fill in before `kustomize build overlays/prod`
# or `kubectl apply -k overlays/prod`. Consumed by the agentevalos-secrets Secret via
# kustomization.yaml's secretGenerator, and injected into agent-orchestrator/eval-engine
# via envFrom (see ../../base/agent-orchestrator.yaml, ../../base/eval-engine.yaml).
# For prod, prefer a secrets manager (e.g. external-secrets) over this file.
DATABASE_URL=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=AGENTEVALOS_APP_ROLE
SNOWFLAKE_WAREHOUSE=AGENTEVALOS_WH
SNOWFLAKE_DATABASE=AGENTEVALOS
SNOWFLAKE_SCHEMA=EVALS
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
